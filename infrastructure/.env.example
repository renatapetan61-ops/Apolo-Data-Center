# Copy to infrastructure/.env and replace values before starting Compose.
POSTGRES_DB=apolo
POSTGRES_USER=apolo
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password
MINIO_ROOT_USER=apolo-admin
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password

# Generate a unique random token of at least 32 characters before deployment.
APOLO_API_TOKEN=replace-with-a-unique-random-token-at-least-32-characters
